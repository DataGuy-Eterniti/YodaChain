{
  "name": "my-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "install-deps": "NODE_OPTIONS=--max-old-space-size=8192 npm install --maxsockets=2 --legacy-peer-deps --no-audit",
    "clean": "npm uninstall \"*\" && rm -rf node_modules .npm/_cacache",
    "reset": "npm run clean && npm run install-deps",
    "dev": "NODE_OPTIONS=--max-old-space-size=512 npx vite",
    "build": "NODE_OPTIONS=--max-old-space-size=512 npx vite build",
    "preview": "vite preview",
    "ci-install": "npm ci --no-audit"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.110.7",
    "@tailwindcss/vite": "^4.1.18",
    "ethers": "^6.17.0",
    "leaflet": "^1.9.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-leaflet": "^4.2.1",
    "react-router-dom": "^7.18.1",
    "tailwindcss": "^4.1.18"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.21",
    "@types/node": "^24.10.1",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^5.1.1",
    "globals": "^16.5.0",
    "typescript": "~5.9.3",
    "vite": "^7.2.4",
    "vite-plugin-svgr": "^4.5.0"
  }
}